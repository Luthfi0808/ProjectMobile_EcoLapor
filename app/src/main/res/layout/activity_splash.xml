<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_eco_rings">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="74.80000000000001dp"
                android:layout_height="74.80000000000001dp"
                android:src="@drawable/ic_ecolapor"
                android:contentDescription="@string/logo_description" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ecolapor_title"
                    android:textColor="@color/eco_text"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.04"
                    android:textSize="34sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_motto"
                    android:textColor="@color/eco_primary"
                    android:textSize="8.5sp"
                    android:letterSpacing="0.16" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            style="@style/EcoBody"
            android:text="@string/brand_caption"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="36dp"
        android:paddingHorizontal="32dp">
        <View
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:background="@color/eco_primary" />
        <TextView
            style="@style/EcoEyebrow"
            android:text="@string/brand_footer"
            android:gravity="center"
            android:layout_marginTop="14dp"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>