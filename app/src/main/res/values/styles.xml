<resources>
    <style name="EcoEyebrow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/eco_muted</item>
    </style>
    <style name="EcoHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">@color/eco_text</item>
    </style>
    <style name="EcoBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/eco_muted</item>
    </style>
    <style name="EcoSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/eco_text</item>
    </style>
    <style name="EcoButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/eco_primary</item>
        <item name="android:textColor">@color/eco_on_primary</item>
        <item name="icon">@drawable/ic_arrow_right</item>
        <item name="iconGravity">end</item>
        <item name="iconTint">@color/eco_on_primary</item>
        <item name="iconSize">18dp</item>
    </style>
    <style name="EcoField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_eco_field</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/eco_text</item>
        <item name="android:textColorHint">@color/eco_muted</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="EcoPhoto">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="EcoBottomIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/eco_secondary</item>
    </style>
</resources>
